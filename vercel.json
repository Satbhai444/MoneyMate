{
    "name":  "moneymate-website",
    "framework":  null,
    "cleanUrls":  true,
    "trailingSlash":  false,
    "headers":  [
                    {
                        "source":  "/(.*)\\.(png|svg|css|js)",
                        "headers":  [
                                        {
                                            "key":  "Cache-Control",
                                            "value":  "public, max-age=604800, stale-while-revalidate=86400"
                                        }
                                    ]
                    },
                    {
                        "source":  "/(.*)",
                        "headers":  [
                                        {
                                            "key":  "X-Content-Type-Options",
                                            "value":  "nosniff"
                                        },
                                        {
                                            "key":  "Referrer-Policy",
                                            "value":  "strict-origin-when-cross-origin"
                                        },
                                        {
                                            "key":  "X-Frame-Options",
                                            "value":  "SAMEORIGIN"
                                        }
                                    ]
                    }
                ],
    "rewrites":  [
                     {
                         "destination":  "/dashboard.html?token=:token",
                         "source":  "/d/:token"
                     }
                 ]
}
